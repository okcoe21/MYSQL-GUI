import { Theme } from "../theme.slint";
import { PanelCard, AlertBanner } from "../components/card.slint";
import { PrimaryButton, SecondaryButton, DangerButton } from "../components/button.slint";
import { TextInputBox, Checkbox } from "../components/input.slint";

export struct TableRowData {
    index: int,
    cells: [string],
}

export struct TableInsertField {
    name: string,
    col_type: string,
    nullable: bool,
    is_default: bool,
    is_null: bool,
    value: string,
}

export component TableDataView inherits Rectangle {
    in-out property <string> db-name: "";
    in-out property <string> table-name: "";
    in-out property <int> total-rows: 0;
    in-out property <int> current-page: 1;
    in-out property <int> total-pages: 1;
    in-out property <int> limit: 50;
    in-out property <string> sort-col: "";
    in-out property <string> sort-order: "ASC";
    in-out property <bool> loading: false;
    in-out property <string> error-message: "";

    in-out property <[string]> columns: [];
    in-out property <[TableRowData]> rows: [];

    in-out property <bool> has-primary-key: true;

    // Inline Cell Edit Modal state
    in-out property <bool> cell-edit-open: false;
    in-out property <string> cell-edit-col-name: "";
    in-out property <string> cell-edit-col-type: "";
    in-out property <bool> cell-edit-nullable: true;
    in-out property <bool> cell-edit-is-null: false;
    in-out property <string> cell-edit-value: "";
    in-out property <string> cell-edit-error: "";
    in-out property <bool> cell-edit-loading: false;
    in-out property <bool> cell-edit-is-pk: false;

    // Insert Row Modal state
    in-out property <bool> insert-modal-open: false;
    in-out property <[TableInsertField]> insert-fields: [];
    in-out property <string> insert-modal-error: "";
    in-out property <bool> insert-modal-loading: false;

    callback prev-page();
    callback next-page();
    callback set-limit(int);
    callback sort(string);
    callback delete-row(int);
    callback refresh();
    callback navigate-insert();

    // Inline edit callbacks
    callback request-cell-edit(int, int);
    callback submit-cell-edit(string, bool);
    callback cancel-cell-edit();

    // Insert modal callbacks
    callback open-insert-modal();
    callback update-insert-field-val(int, string);
    callback update-insert-field-null(int, bool);
    callback update-insert-field-default(int, bool);
    callback submit-insert-modal();
    callback cancel-insert-modal();

    background: Theme.bg-base;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top control toolbar
        HorizontalLayout {
            alignment: space-between;

            // Left: Table info + Row count + Read-only badge
            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: "📋 " + root.table-name;
                    color: Theme.accent;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }

                Text {
                    text: "(" + root.total-rows + " total rows)";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }

                if !root.has-primary-key : Rectangle {
                    height: 24px;
                    background: Theme.danger-subtle;
                    border-color: Theme.danger;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "⚠️ No primary key: read-only";
                            color: Theme.danger;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right: Pagination & Actions
            HorizontalLayout {
                spacing: 8px;

                // Limit buttons
                HorizontalLayout {
                    spacing: 4px;

                    Text {
                        text: "Show:";
                        color: Theme.text-subtle;
                        font-size: Theme.font-xs;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 32px;
                        height: 26px;
                        background: root.limit == 25 ? Theme.bg-active : Theme.bg-panel;
                        border-color: root.limit == 25 ? Theme.accent : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        Text {
                            text: "25";
                            color: root.limit == 25 ? Theme.accent : Theme.text-muted;
                            font-size: Theme.font-xs;
                            font-weight: root.limit == 25 ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-limit(25); }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 26px;
                        background: root.limit == 50 ? Theme.bg-active : Theme.bg-panel;
                        border-color: root.limit == 50 ? Theme.accent : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        Text {
                            text: "50";
                            color: root.limit == 50 ? Theme.accent : Theme.text-muted;
                            font-size: Theme.font-xs;
                            font-weight: root.limit == 50 ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-limit(50); }
                        }
                    }

                    Rectangle {
                        width: 36px;
                        height: 26px;
                        background: root.limit == 100 ? Theme.bg-active : Theme.bg-panel;
                        border-color: root.limit == 100 ? Theme.accent : Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        Text {
                            text: "100";
                            color: root.limit == 100 ? Theme.accent : Theme.text-muted;
                            font-size: Theme.font-xs;
                            font-weight: root.limit == 100 ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set-limit(100); }
                        }
                    }
                }

                // Prev / Next Pagination
                HorizontalLayout {
                    spacing: 4px;

                    SecondaryButton {
                        text: "◀ Prev";
                        custom-font-size: Theme.font-xs;
                        height: 26px;
                        enabled: root.current-page > 1;
                        clicked => { root.prev-page(); }
                    }

                    Rectangle {
                        height: 26px;
                        background: Theme.bg-panel;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.current-page + " / " + root.total-pages;
                                color: Theme.foreground;
                                font-size: Theme.font-xs;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                        }
                    }

                    SecondaryButton {
                        text: "Next ▶";
                        custom-font-size: Theme.font-xs;
                        height: 26px;
                        enabled: root.current-page < root.total-pages;
                        clicked => { root.next-page(); }
                    }
                }

                SecondaryButton {
                    text: "↻ Refresh";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    clicked => { root.refresh(); }
                }

                PrimaryButton {
                    text: "+ Insert Row";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    clicked => { root.open-insert-modal(); }
                }
            }
        }

        if root.error-message != "" : AlertBanner {
            text: root.error-message;
            level: "error";
        }

        // Data Table Panel
        PanelCard {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 0px;

                // Header Row
                Rectangle {
                    height: 36px;
                    background: Theme.bg-header;
                    border-color: Theme.border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        // Actions header
                        Text {
                            text: "ACTION";
                            color: Theme.accent;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            font-family: Theme.font-mono;
                            width: 65px;
                            vertical-alignment: center;
                        }

                        // Column headers
                        for col in root.columns: Rectangle {
                            height: 36px;
                            background: col_touch.has-hover ? Theme.bg-hover : transparent;

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: col;
                                    color: (root.sort-col == col) ? Theme.accent : Theme.foreground;
                                    font-size: Theme.font-xs;
                                    font-weight: 600;
                                    font-family: Theme.font-mono;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                if root.sort-col == col : Text {
                                    text: root.sort-order == "ASC" ? "▲" : "▼";
                                    color: Theme.accent;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            col_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort(col); }
                            }
                        }
                    }
                }

                // Table Rows
                if root.loading : Rectangle {
                    height: 120px;
                    Text {
                        text: "Loading data...";
                        color: Theme.accent;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !root.loading && root.rows.length == 0 : Rectangle {
                    height: 120px;
                    Text {
                        text: "Table is empty. No rows found.";
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !root.loading && root.rows.length > 0 : Flickable {
                    vertical-stretch: 1;
                    content-height: rows_layout.preferred-height;

                    rows_layout := VerticalLayout {
                        spacing: 1px;

                        for row in root.rows: Rectangle {
                            height: 34px;
                            background: Math.mod(row.index, 2) == 0 ? Theme.bg-panel : Theme.bg-base;
                            border-color: Theme.border;
                            border-width: 1px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                // Action delete button
                                HorizontalLayout {
                                    width: 65px;

                                    if root.has-primary-key : del_btn := Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: Theme.radius;
                                        background: del_touch.has-hover ? Theme.danger-subtle : transparent;

                                        Text {
                                            text: "✕";
                                            color: del_touch.has-hover ? Theme.danger : Theme.text-subtle;
                                            font-size: Theme.font-xs;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        del_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.delete-row(row.index); }
                                        }
                                    }

                                    if !root.has-primary-key : Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        Text {
                                            text: "🔒";
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Column cells
                                for cell[col_idx] in row.cells: Rectangle {
                                    height: 34px;
                                    background: cell_touch.has-hover && root.has-primary-key ? Theme.bg-hover : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: cell == "NULL" ? "NULL" : cell;
                                            color: cell == "NULL" ? Theme.text-subtle : Theme.foreground;
                                            font-size: Theme.font-xs;
                                            font-italic: cell == "NULL";
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    cell_touch := TouchArea {
                                        enabled: root.has-primary-key;
                                        mouse-cursor: root.has-primary-key ? pointer : default;
                                        double-clicked => {
                                            root.request-cell-edit(row.index, col_idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Cell Edit Modal Overlay
    if root.cell-edit-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);

        TouchArea {
            // Block background clicks
        }

        Rectangle {
            width: 440px;
            background: Theme.bg-panel;
            border-color: Theme.accent;
            border-width: 1px;
            border-radius: Theme.radius;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "✏️ Edit Cell: " + root.cell-edit-col-name;
                        color: Theme.accent;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "[" + root.cell-edit-col-type + "]";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                }

                if root.cell-edit-error != "" : AlertBanner {
                    text: root.cell-edit-error;
                    level: "error";
                }

                if root.cell-edit-is-pk : Rectangle {
                    height: 28px;
                    background: Theme.danger-subtle;
                    border-color: Theme.danger;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "🔒 Primary key: delete and re-insert instead";
                            color: Theme.danger;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;

                    TextInputBox {
                        text <=> root.cell-edit-value;
                        placeholder: root.cell-edit-is-null ? "(NULL)" : "Value...";
                        enabled: !root.cell-edit-is-null && !root.cell-edit-loading && !root.cell-edit-is-pk;
                        accepted => {
                            if !root.cell-edit-is-pk {
                                root.submit-cell-edit(root.cell-edit-value, root.cell-edit-is-null);
                            }
                        }
                    }

                    if root.cell-edit-nullable : Checkbox {
                        text: "Set NULL";
                        checked <=> root.cell-edit-is-null;
                        enabled: !root.cell-edit-loading && !root.cell-edit-is-pk;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    SecondaryButton {
                        text: "Cancel";
                        enabled: !root.cell-edit-loading;
                        clicked => {
                            root.cancel-cell-edit();
                        }
                    }

                    PrimaryButton {
                        text: "Save Change";
                        loading: root.cell-edit-loading;
                        enabled: !root.cell-edit-loading && !root.cell-edit-is-pk;
                        clicked => {
                            root.submit-cell-edit(root.cell-edit-value, root.cell-edit-is-null);
                        }
                    }
                }
            }
        }
    }

    // Insert Row Modal Overlay
    if root.insert-modal-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);

        TouchArea {
            // Block background clicks
        }

        Rectangle {
            width: 560px;
            height: Math.min(parent.height - 60px, 520px);
            background: Theme.bg-panel;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "➕ Insert New Row - " + root.table-name;
                        color: Theme.accent;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        font-family: Theme.font-mono;
                    }
                }

                if root.insert-modal-error != "" : AlertBanner {
                    text: root.insert-modal-error;
                    level: "error";
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: modal_fields.preferred-height;

                    modal_fields := VerticalLayout {
                        spacing: 12px;
                        padding-right: 8px;

                        for fld[idx] in root.insert-fields : VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: fld.name;
                                        color: Theme.foreground;
                                        font-size: Theme.font-xs;
                                        font-weight: 600;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "(" + fld.col_type + ")";
                                        color: Theme.text-subtle;
                                        font-size: Theme.font-xs;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Checkbox {
                                        text: "Default/Auto";
                                        checked: fld.is_default;
                                        enabled: !root.insert-modal-loading;
                                        toggled(c) => {
                                            root.update-insert-field-default(idx, c);
                                        }
                                    }

                                    if fld.nullable : Checkbox {
                                        text: "NULL";
                                        checked: fld.is_null;
                                        enabled: !fld.is_default && !root.insert-modal-loading;
                                        toggled(c) => {
                                            root.update-insert-field-null(idx, c);
                                        }
                                    }
                                }
                            }

                            TextInputBox {
                                text: fld.value;
                                placeholder: fld.is_default ? "(Default / Auto Increment)" : (fld.is_null ? "(NULL)" : "Value...");
                                enabled: !fld.is_default && !fld.is_null && !root.insert-modal-loading;
                                edited(t) => {
                                    root.update-insert-field-val(idx, t);
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    SecondaryButton {
                        text: "Cancel";
                        enabled: !root.insert-modal-loading;
                        clicked => {
                            root.cancel-insert-modal();
                        }
                    }

                    PrimaryButton {
                        text: "💾 Insert Row";
                        loading: root.insert-modal-loading;
                        enabled: !root.insert-modal-loading;
                        clicked => {
                            root.submit-insert-modal();
                        }
                    }
                }
            }
        }
    }
}
