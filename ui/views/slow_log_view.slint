import { Theme } from "../theme.slint";
import { PanelCard, AlertBanner } from "../components/card.slint";
import { SecondaryButton } from "../components/button.slint";

export struct SlowLogItem {
    start_time: string,
    user_host: string,
    query_time: string,
    lock_time: string,
    rows_sent: string,
    rows_examined: string,
    sql_text: string,
}

export component SlowLogViewView inherits Rectangle {
    in-out property <[SlowLogItem]> logs: [];
    in-out property <string> error-message: "";

    callback refresh();

    background: Theme.bg-base;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: content.preferred-height;

        content := VerticalLayout {
            padding: 20px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "SLOW QUERY LOG";
                        color: Theme.accent;
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "Inspecting mysql.slow_log entries (" + root.logs.length + " recorded)";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        font-family: Theme.font-mono;
                    }
                }

                SecondaryButton {
                    text: "↻ Refresh Logs";
                    clicked => { root.refresh(); }
                }
            }

            if root.error-message != "" : AlertBanner {
                text: root.error-message;
                level: "warning";
            }

            if root.logs.length == 0 && root.error-message == "" : Rectangle {
                height: 140px;
                Text {
                    text: "No slow queries recorded in mysql.slow_log.";
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    font-family: Theme.font-mono;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            PanelCard {
                VerticalLayout {
                    padding: 0px;

                    // Header
                    Rectangle {
                        height: 36px;
                        background: Theme.bg-header;
                        border-color: Theme.border;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text { text: "START TIME"; color: Theme.accent; font-size: Theme.font-xs; font-weight: 700; width: 150px; vertical-alignment: center; font-family: Theme.font-mono; }
                            Text { text: "CLIENT"; color: Theme.accent; font-size: Theme.font-xs; font-weight: 700; width: 140px; vertical-alignment: center; font-family: Theme.font-mono; }
                            Text { text: "QUERY TIME"; color: Theme.accent; font-size: Theme.font-xs; font-weight: 700; width: 90px; vertical-alignment: center; font-family: Theme.font-mono; }
                            Text { text: "LOCK TIME"; color: Theme.accent; font-size: Theme.font-xs; font-weight: 700; width: 80px; vertical-alignment: center; font-family: Theme.font-mono; }
                            Text { text: "ROWS"; color: Theme.accent; font-size: Theme.font-xs; font-weight: 700; width: 80px; vertical-alignment: center; font-family: Theme.font-mono; }
                            Text { text: "SQL TEXT"; color: Theme.accent; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; font-family: Theme.font-mono; }
                        }
                    }

                    // Log Rows
                    VerticalLayout {
                        spacing: 1px;

                        for lg[i] in root.logs: Rectangle {
                            height: 36px;
                            background: Math.mod(i, 2) == 0 ? Theme.bg-panel : Theme.bg-base;
                            border-color: Theme.border;
                            border-width: 1px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                Text { text: lg.start_time; color: Theme.text-muted; font-size: Theme.font-xs; width: 150px; vertical-alignment: center; font-family: Theme.font-mono; }
                                Text { text: lg.user_host; color: Theme.foreground; font-size: Theme.font-xs; width: 140px; vertical-alignment: center; font-family: Theme.font-mono; overflow: elide; }
                                Text { text: lg.query_time; color: Theme.danger; font-size: Theme.font-xs; width: 90px; vertical-alignment: center; font-family: Theme.font-mono; }
                                Text { text: lg.lock_time; color: Theme.text-subtle; font-size: Theme.font-xs; width: 80px; vertical-alignment: center; font-family: Theme.font-mono; }
                                Text { text: lg.rows_sent + " / " + lg.rows_examined; color: Theme.text-muted; font-size: Theme.font-xs; width: 80px; vertical-alignment: center; font-family: Theme.font-mono; }
                                Text { text: lg.sql_text; color: Theme.foreground; font-size: Theme.font-xs; vertical-alignment: center; font-family: Theme.font-mono; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { }
    }
}
