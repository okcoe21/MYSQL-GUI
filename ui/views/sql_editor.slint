import { Theme } from "../theme.slint";
import { MultilineInputBox } from "../components/input.slint";
import { PrimaryButton, SecondaryButton } from "../components/button.slint";
import { PanelCard, AlertBanner } from "../components/card.slint";

export struct SqlResultRow {
    cells: [string],
}

export struct SqlTabItem {
    id: int,
    title: string,
    is_running: bool,
    has_unsaved_text: bool,
}

export component SqlEditorView inherits Rectangle {
    in-out property <string> db-name: "";
    in-out property <string> query <=> sql_input.text;
    in-out property <bool> loading: false;
    in-out property <string> message: "";
    in-out property <string> error-message: "";
    in-out property <int> execution-time-ms: 0;
    in-out property <int> affected-rows: -1;

    in-out property <[string]> result-columns: [];
    in-out property <[SqlResultRow]> result-rows: [];

    in-out property <bool> explain-open: false;
    in-out property <string> explain-summary: "";
    in-out property <[string]> explain-lines: [];
    in-out property <[string]> explain-warnings: [];

    in-out property <[SqlTabItem]> tabs: [];
    in-out property <int> active-tab-id: 1;
    in-out property <bool> can-add-tab: true;

    callback run-query(string);
    callback clear-query();
    callback explain-query(string);
    callback switch-tab(int);
    callback close-tab(int);
    callback add-tab();

    background: Theme.bg-base;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top toolbar
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "SQL QUERY CONSOLE" + (root.db-name != "" ? " [" + root.db-name + "]" : "");
                    color: Theme.accent;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    font-family: Theme.font-mono;
                }
                Text {
                    text: "Execute custom queries, DDL, or batch SQL statements";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    font-family: Theme.font-mono;
                }
            }

            // Presets
            HorizontalLayout {
                spacing: 6px;

                SecondaryButton {
                    text: "SELECT *";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    clicked => {
                        root.query = "SELECT * FROM ";
                    }
                }

                SecondaryButton {
                    text: "INSERT";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    clicked => {
                        root.query = "INSERT INTO  () VALUES ();";
                    }
                }

                SecondaryButton {
                    text: "SHOW TABLES";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    clicked => {
                        root.query = "SHOW TABLES;";
                    }
                }

                SecondaryButton {
                    text: "Clear";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    clicked => {
                        root.query = "";
                        root.explain-open = false;
                        root.clear-query();
                    }
                }

                SecondaryButton {
                    text: root.explain-open ? "💡 Hide Explain" : "💡 Explain";
                    custom-font-size: Theme.font-xs;
                    height: 26px;
                    enabled: root.query != "";
                    clicked => {
                        if root.explain-open {
                            root.explain-open = false;
                        } else {
                            root.explain-query(root.query);
                        }
                    }
                }

                PrimaryButton {
                    text: "▶ Run Query";
                    loading: root.loading;
                    enabled: !root.loading && root.query != "";
                    height: 30px;
                    clicked => {
                        root.run-query(root.query);
                    }
                }
            }
        }

        // SQL Tabs Bar
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 32px;

            for tab in root.tabs : Rectangle {
                background: root.active-tab-id == tab.id ? Theme.bg-panel : (tab_touch.has-hover ? Theme.bg-hover : Theme.bg-header);
                border-color: root.active-tab-id == tab.id ? Theme.accent : Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;
                height: 30px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 6px;
                    alignment: center;

                    tab_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.switch-tab(tab.id);
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            if tab.is-running : Text {
                                text: "⏳";
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }

                            Text {
                                text: tab.title;
                                color: root.active-tab-id == tab.id ? Theme.accent : Theme.foreground;
                                font-size: Theme.font-xs;
                                font-weight: root.active-tab-id == tab.id ? 700 : 500;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }

                            if tab.has-unsaved-text : Text {
                                text: "•";
                                color: Theme.accent;
                                font-size: Theme.font-sm;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Close tab button
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 2px;
                        background: close_tab_touch.has-hover ? Theme.bg-hover : transparent;

                        Text {
                            text: "✕";
                            color: close_tab_touch.has-hover ? Theme.danger : Theme.text-muted;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close_tab_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-tab(tab.id);
                            }
                        }
                    }
                }
            }

            // New Tab (+) Button
            Rectangle {
                width: 30px;
                height: 30px;
                background: !root.can-add-tab ? Theme.bg-base : (add_touch.has-hover ? Theme.bg-hover : Theme.bg-header);
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;

                Text {
                    text: "+";
                    color: !root.can-add-tab ? Theme.text-subtle : (add_touch.has-hover ? Theme.accent : Theme.text-muted);
                    font-size: Theme.font-md;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                add_touch := TouchArea {
                    enabled: root.can-add-tab;
                    mouse-cursor: root.can-add-tab ? pointer : default;
                    clicked => {
                        root.add-tab();
                    }
                }
            }
        }

        // SQL Input Box
        Rectangle {
            height: 160px;
            sql_input := MultilineInputBox {
                placeholder: "Enter SQL statement (e.g. SELECT * FROM users LIMIT 10;)...";
            }
        }

        // Collapsible Query Explain Panel
        if root.explain-open : Rectangle {
            background: Theme.bg-panel;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "QUERY EXPLANATION (OFFLINE)";
                        color: Theme.accent;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: Theme.radius;
                        background: close_touch.has-hover ? Theme.bg-hover : transparent;

                        Text {
                            text: "✕";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close_touch := TouchArea {
                            clicked => {
                                root.explain-open = false;
                            }
                        }
                    }
                }

                // Summary
                Text {
                    text: root.explain-summary;
                    color: Theme.foreground;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    font-family: Theme.font-mono;
                    wrap: word-wrap;
                }

                // Clause Breakdown Lines
                if root.explain-lines.length > 0 : VerticalLayout {
                    spacing: 4px;
                    for line in root.explain-lines: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "•";
                            color: Theme.accent;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-mono;
                            vertical-alignment: top;
                        }
                        Text {
                            text: line;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-mono;
                            wrap: word-wrap;
                        }
                    }
                }

                // Warnings
                if root.explain-warnings.length > 0 : VerticalLayout {
                    spacing: 4px;
                    for warn in root.explain-warnings: Rectangle {
                        background: Theme.bg-header;
                        border-color: Theme.warning;
                        border-width: 1px;
                        border-radius: Theme.radius;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            Text {
                                text: "⚠";
                                color: Theme.warning;
                                font-size: Theme.font-sm;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: warn;
                                color: Theme.warning;
                                font-size: Theme.font-xs;
                                font-weight: 600;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // Status / Message bar
        if root.error-message != "" : AlertBanner {
            text: root.error-message;
            level: "error";
        }

        if root.message != "" && root.error-message == "" : AlertBanner {
            text: root.message + " (" + root.execution-time-ms + " ms)";
            level: "success";
        }

        // Results Section
        PanelCard {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 0px;

                // Header info
                Rectangle {
                    height: 34px;
                    background: Theme.bg-header;
                    border-color: Theme.border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        Text {
                            text: "RESULTS (" + root.result-rows.length + " rows)";
                            color: Theme.accent;
                            font-size: Theme.font-xs;
                            font-weight: 700;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }

                        if root.execution-time-ms > 0 : Text {
                            text: "Execution: " + root.execution-time-ms + " ms";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                    }
                }

                // Table Columns Header
                if root.result-columns.length > 0 : Rectangle {
                    height: 32px;
                    background: Theme.bg-panel;
                    border-color: Theme.border;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;

                        for col in root.result-columns: Text {
                            text: col;
                            color: Theme.accent;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Table Rows
                if root.result-rows.length == 0 && root.error-message == "" && root.message == "" : Rectangle {
                    height: 120px;
                    Text {
                        text: "Enter a query above and click 'Run Query'.";
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                        font-family: Theme.font-mono;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.result-rows.length > 0 : Flickable {
                    vertical-stretch: 1;
                    content-height: res_rows.preferred-height;

                    res_rows := VerticalLayout {
                        spacing: 1px;

                        for row[i] in root.result-rows: Rectangle {
                            height: 32px;
                            background: Math.mod(i, 2) == 0 ? Theme.bg-panel : Theme.bg-base;
                            border-color: Theme.border;
                            border-width: 1px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                for cell in row.cells: Text {
                                    text: cell == "NULL" ? "NULL" : cell;
                                    color: cell == "NULL" ? Theme.text-subtle : Theme.foreground;
                                    font-size: Theme.font-xs;
                                    font-italic: cell == "NULL";
                                    font-family: Theme.font-mono;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
