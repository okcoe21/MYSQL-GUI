import { Theme } from "../theme.slint";
import { PanelCard } from "../components/card.slint";
import { SecondaryButton } from "../components/button.slint";

export struct RelationItem {
    table_name: string,
    column_name: string,
    ref_table: string,
    ref_column: string,
}

export struct DiagramTableItem {
    name: string,
    columns: [string],
}

export component DiagramViewView inherits Rectangle {
    in-out property <string> db-name: "";
    in-out property <[DiagramTableItem]> tables: [];
    in-out property <[RelationItem]> relations: [];

    callback refresh();
    callback select-table(string);

    background: Theme.bg-base;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: content.preferred-height;

        content := VerticalLayout {
            padding: 20px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "ER SCHEMA DIAGRAM: " + root.db-name;
                        color: Theme.accent;
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        font-family: Theme.font-mono;
                    }
                    Text {
                        text: "Entity relationships and foreign key references";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        font-family: Theme.font-mono;
                    }
                }

                SecondaryButton {
                    text: "↻ Refresh Diagram";
                    clicked => { root.refresh(); }
                }
            }

            // Relations List
            if root.relations.length > 0 : PanelCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "FOREIGN KEY CONSTRAINTS (" + root.relations.length + ")";
                        color: Theme.accent;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        font-family: Theme.font-mono;
                    }

                    for rel in root.relations: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "🔗 " + rel.table_name + "." + rel.column_name + " ➔ " + rel.ref_table + "." + rel.ref_column;
                            color: Theme.foreground;
                            font-size: Theme.font-xs;
                            font-family: Theme.font-mono;
                        }
                    }
                }
            }

            // Table Nodes Grid
            VerticalLayout {
                spacing: 12px;

                Text {
                    text: "DATABASE TABLES (" + root.tables.length + ")";
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                    font-family: Theme.font-mono;
                }

                for tbl in root.tables: PanelCard {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "📋 " + tbl.name;
                                color: Theme.accent;
                                font-size: Theme.font-sm;
                                font-weight: 700;
                                font-family: Theme.font-mono;
                            }

                            SecondaryButton {
                                text: "Open Table";
                                custom-font-size: Theme.font-xs;
                                height: 24px;
                                clicked => { root.select-table(tbl.name); }
                            }
                        }

                        if tbl.columns.length > 0 : VerticalLayout {
                            spacing: 2px;
                            for col in tbl.columns: Text {
                                text: "  • " + col;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                font-family: Theme.font-mono;
                            }
                        }
                    }
                }
            }
        }
        Rectangle { }
    }
}
