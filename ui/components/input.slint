import { Theme } from "../theme.slint";

export component TextInputBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder: "";
    in-out property <bool> enabled: true;
    in-out property <length> font-size: Theme.font-sm;
    callback accepted(string);
    callback edited(string);

    background: Theme.bg-input;
    border-color: input.has-focus ? Theme.border-focus : Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;
    height: 34px;

    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        input := TextInput {
            enabled: root.enabled;
            color: Theme.foreground;
            font-size: root.font-size;
            vertical-alignment: center;
            font-family: Theme.font-mono;
            single-line: true;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }

    if input.text == "" && !input.has-focus : Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text-subtle;
        font-size: root.font-size;
        font-family: Theme.font-mono;
    }
}

export component PasswordInputBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder: "";
    in-out property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);

    background: Theme.bg-input;
    border-color: input.has-focus ? Theme.border-focus : Theme.border;
